    if response == 0:
        print(f"{ip} is alive")


- 빠른코드 threading
import os
import threading

def ping(ip):
    response = os.system(f"ping -c 1 -W 1 {ip} > /dev/null 2>&1")
    if response == 0:
        print(f"{ip} is alive")

threads = []

for i in range(1, 255):
    ip = f"192.168.0.{i}"
    t = threading.Thread(target=ping, args=(ip,))
    threads.append(t)

for t in threads:
    t.start()

for t in threads:
    t.join()
